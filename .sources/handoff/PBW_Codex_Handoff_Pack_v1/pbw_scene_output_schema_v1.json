{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/pbw-scene-output.schema.json",
  "title": "PBW Scene Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "player_facing",
    "dramatic_layers",
    "npc_beats",
    "internal"
  ],
  "properties": {
    "player_facing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_title",
        "scene_title",
        "scene_record",
        "current_objective",
        "choices"
      ],
      "properties": {
        "chapter_title": {
          "type": "string",
          "minLength": 1
        },
        "scene_title": {
          "type": "string",
          "minLength": 1
        },
        "scene_record": {
          "type": "string",
          "minLength": 1
        },
        "current_objective": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "risk_hint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "relation_hint": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "dramatic_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_pulse",
        "human_drama",
        "relation_cost",
        "memory_echo",
        "world_echo"
      ],
      "properties": {
        "scene_pulse": {
          "type": "string",
          "minLength": 1
        },
        "human_drama": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "subtext",
            "cannot_say"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "subtext": {
              "type": "string",
              "minLength": 1
            },
            "cannot_say": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "relation_cost": {
          "type": "string",
          "minLength": 1
        },
        "memory_echo": {
          "type": "string",
          "minLength": 1
        },
        "world_echo": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "npc_beats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "npc_id",
          "display_name",
          "role",
          "relation_stage",
          "rupture_stage",
          "motion_cue",
          "first_line",
          "second_line",
          "third_line_or_null"
        ],
        "properties": {
          "npc_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "relation_stage": {
            "type": "string",
            "enum": [
              "S0",
              "S1",
              "S2",
              "S3",
              "S4",
              "S5",
              "S6"
            ]
          },
          "rupture_stage": {
            "type": "string",
            "enum": [
              "stable",
              "micro_leak",
              "local_break",
              "clear_break"
            ]
          },
          "motion_cue": {
            "type": "string",
            "minLength": 1
          },
          "first_line": {
            "type": "string",
            "minLength": 1
          },
          "second_line": {
            "type": "string",
            "minLength": 1
          },
          "third_line_or_null": {
            "type": [
              "string",
              "null"
            ]
          },
          "subsurface_note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "internal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_checks",
        "violations"
      ],
      "properties": {
        "style_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}