{
  "schema_version": "1.0",
  "name": "Fantasy_Equipment_Naming_Dictionary",
  "purpose": "装備名・名品名・伝説武具名生成用外部辞典",
  "display_policy": {
    "default_surface": "固有名を主表示",
    "recommended_ui": "{surface_name}",
    "recommended_codex": "{surface_name}（{weapon_type}）《{annotation}》",
    "annotation_format": "《意味注釈》"
  },
  "generation_order": [
    "race",
    "weapon_type",
    "rarity_tier",
    "semantic_theme",
    "phoneme_root",
    "item_suffix",
    "annotation"
  ],
  "rarity_tiers": {
    "common": "一般装備・量産品",
    "named": "名品・工房銘あり",
    "relic": "遺物・祭具・家宝",
    "legendary": "伝説級・神話級"
  },
  "weapon_types": [
    "直剣",
    "大剣",
    "刀",
    "槍",
    "斧",
    "戦槌",
    "弓",
    "短剣",
    "杖",
    "魔導書",
    "拳甲",
    "鎖鎌"
  ],
  "rules": {
    "common_pattern": "{culture_label}式{weapon_type}",
    "named_pattern": "{surface_name}",
    "relic_pattern": "{surface_name}《{annotation}》",
    "legendary_pattern": "{surface_name}《{annotation}》",
