{
  "schema_version": "1.0",
  "project": "TRPG_Equipment_Name_Lexicon",
  "language": "ja",
  "purpose": "12種族・12属性・12武器に対応した装備名生成用の語彙辞書。種族文化・属性印象・武器語彙を組み合わせて、和風寄りの漢字中心名や通称を生成する。",
  "design_principles": [
    "種族ごとに文化背景に基づく語彙を割り当てる",
    "属性ごとに印象語・象徴語・接尾語を分ける",
    "武器ごとに正式名・通称・古名を分ける",
    "生成時は 種族語彙 → 属性語彙 → 紋様語彙 → 材質語彙 → 武器語彙 → 二つ名 の順に積む",
    "現実文化は直接複製せず、造形原理を抽象化したモチーフとして用いる"
  ],
  "generation_order": [
    "tone",
    "race",
    "attribute",
    "motif",
    "material",
    "weapon",
    "epithet",
    "artifact_title"
  ],
  "connectors": {
    "linkers": [
      "の",
      "にして",
      "を帯びた",
      "刻みの",
      "織りの",
      "冠する",
      "宿す",
      "結んだ"
    ],
    "styles": {
      "plain": [
        "{motif}{weapon}",
        "{attribute_prefix}の{weapon}",
        "{material}{weapon}"
      ],
      "standard": [
        "{race_prefix}式{weapon}",
        "{motif}刻みの{material}{weapon}",
        "{attribute_prefix}の{epithet}{weapon}"
      ],
      "formal": [
        "{place}の{title}{weapon}",
        "{race_prefix}の{oath}{weapon}",
        "{attribute_prefix}{material}{weapon}《{artifact_title}》"
      ],
      "legendary": [
        "{race_prefix}の{epithet}{weapon}《{artifact_title}》",
        "{place}に眠る{motif}{weapon}",
        "{title}を冠する{attribute_prefix}{weapon}"
      ],
      "cursed": [
        "{broken_motif}の{weapon}",
        "{attribute_prefix}を喰む{weapon}",
        "{oath}を破った{weapon}"
      ]
    }
  },
