{
  "schema_version": "3.0",
  "project": "PBW_Autonomous_World_Simulator",
  "design_goal": "12種族・神格化・輪廻・マナ/魔素・ダンジョン・異界・魔王・国家・宗教・ギルド・生活層を同一法則上で自走させ、固定テンプレートではなく世界状態から新しいEra・事件・クエストを自動生成する。",
  "design_principles": [
    "Eraは固定カテゴリではなく、複数の世界変数の支配的な変動状態に後付けで与えられる名前である。",
    "神は創造神に直接作られる存在と、召し上げられて神格化する存在の両方がありうる。",
    "主人公の成長は戦闘勝利だけでなく、歴史への因果足跡によって存在級位が上昇する。",
    "種族はロールではなく歴史反応傾向であり、Era・資源・信仰・環境・没落条件への感受性が異なる。",
    "ミクロの人間関係がマクロの社会変化を生み、一定の閾値を超えるとメタ構造とEraへ波及する。"
  ],
  "cosmology": {
    "root_laws": {
      "creator_god_exists": true,
      "main_god_exists": true,
      "calendar_rule": "主神が交代すると暦名が変わる。各時代は（主神名）暦XX年で記録される。",
      "reincarnation_exists": true,
      "protagonist_is_exceptional_soul": true,
      "apotheosis_rule": "人・精霊・魔族・英雄・その他の存在は、創造神に召し上げられることで神格化しうる。",
      "divine_wars_possible": true,
      "institutional_gods_possible": true
    },
    "mana_and_miasma": {
      "mana": {
        "nature": "秩序立った術式・文明・祝福・工芸・神殿回路に乗りやすい超常エネルギー",
