    "pressure_formulas_concept": [
      "現象 = 変数 × 演算子 × 地域共鳴 × 種族感受性 × 残滓補正",
      "Era候補 = 複数地域で長期間支配的な現象クラスタ",
      "Era名 = 現象クラスタ + 文化圏ごとの命名規則"
    ],
    "resonance_vector": {
      "description": "地域・種族・神格・ダンジョン・Eraは12属性の共鳴ベクトルを持つ。同じ原因でも共鳴により現象の表情が変わる。",
      "attributes_used": [
        "fire",
        "water",
        "wind",
        "earth",
        "light",
        "dark",
        "explosion",
        "ice",
        "thunder",
        "metal",
        "healing",
        "mind"
      ]
    }
  },
  "era_synthesis": {
    "era_definition": "ある期間、世界全体または大陸規模で、複数の基盤変数の変動が日常生活・政治・信仰・戦争を支配し続けた状態。",
    "era_layers": [
      {
        "layer": "main_god_calendar",
        "description": "主神単位の長大な紀年。主神の交代や沈黙で暦名が変わる。"
      },
      {
        "layer": "world_era",
        "description": "全球的・大陸的に支配的な現象クラスタ。"
      },
      {
        "layer": "regional_phase",
        "description": "同じ世界Eraの中で地方ごとに異なる生活圧・宗教相・戦時相。"
      }
    ],
    "era_generation_pipeline": [
      "地域ごとの世界変数を更新する",
      "演算子を適用し、現象クラスタを抽出する",
      "複数地域・複数勢力に跨る持続支配が起きたら世界Era候補とする",
      "公式名・民間名・異端名・年代記名を並列生成する",
      "前Eraの残滓を新Eraへ継承する"
    ],
    "naming_grammar": {
      "official": "[主因名詞]+[再編/戦役/統制/期/令]",
      "popular": "[色/自然物/日用品/身体感覚]+[やせた/燃えた/溢れた/眠らぬ]+[年/時代]",
      "heretical": "[神格否定語/偽/断/逆]+[光/契約/潮/輪]+[期/暦/禍]",
      "chronicle": "（主神名）暦[年数]年より続く[原因+社会相+期]"
    },
    "era_inertia_rules": {
      "entry": "単月・単季節ではEra化しない。複数季節〜複数年の支配持続が必要。",
      "exit": "主因が減衰しても残滓が一定以上なら移行相に留まる。",
      "overlap": "旧Eraの制度残滓と新Eraの生活圧が重なるため、遷移相イベントが多発する。"
    }
  },
